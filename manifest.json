{
  "schemaVersion": 1,
  "id": "rafael.omarchy-obsidian-panel",
  "name": "Obsidian Panel",
  "version": "1.2.0",
  "author": "rafaelmehdiyev",
  "description": "Search notes across Obsidian vaults from the menu bar",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Obsidian Vaults",
    "description": "Search notes and open vaults",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "obsidianConfigDir",
        "type": "path",
        "default": "${XDG_CONFIG_HOME:-$HOME/.config}/obsidian",
        "description": "Directory where Obsidian stores its config (obsidian.json)"
      },
      {
        "key": "autoOpenAfterCreate",
        "type": "boolean",
        "default": true,
        "description": "Automatically open the new vault after creating it"
      }
    ]
  }
}
